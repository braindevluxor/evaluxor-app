# Copiá este archivo como .env y completá los valores reales.
# .env está en .gitignore y nunca se sube al repositorio.

# Supabase (cliente)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# API de precios (deliveryluxor.store): la envía el cliente al proxy same-origin
VITE_PRECIOS_API_KEY=

# API de flota/vehículos (dev-logix): la envía el cliente al proxy same-origin
VITE_VEHICLES_API_KEY=

# ---- Secretos del lado servidor (NO usar prefijo VITE_ en producción) ----
# Vista por la edge function de Vercel /api/flota/vehicles y opcional local (vercel dev)
VEHICLES_API_KEY=
# Vista por Supabase Functions (listar-colaboradores)
COLABORADORES_API_KEY=